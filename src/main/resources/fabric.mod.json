{
    "schemaVersion": 1,
    "id": "hatefrance",
    "version": "${version}",
    "name": "HateFrance",
    "description": "Client-side NoammAddons extension for Hypixel SkyBlock with Dance Room automation, experiment solvers, and configurable auto-clicking.",
    "authors": [
        "Noamm",
        "jcnlk"
    ],
    "contact": {
        "homepage": "https://github.com/jcnlk/HateFrance",
        "issues": "https://github.com/jcnlk/HateFrance/issues"
    },
    "license": "CC0-1.0",
    "icon": "assets/hatefrance/icon.png",
    "environment": "client",
    "entrypoints": {
        "modmenu": [
            "com.github.noamm9.hatefrance.compat.ModMenuIntegration"
        ],
        "client": [
            {
                "value": "com.github.noamm9.hatefrance.HateFrance",
                "adapter": "kotlin"
            }
        ]
    },
    "mixins": [
        "hatefrance.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${loader_version}",
        "fabric-language-kotlin": ">=${kotlin_loader_version}",
        "fabric-api": "*",
        "noammaddons": "${noammaddons_version}",
        "minecraft": "${minecraft_version}"
    },
    "suggests": {
        "modmenu": "*"
    },
    "breaks": {
        "dancingsquared": "*"
    }
}
