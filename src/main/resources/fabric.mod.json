{
  "schemaVersion": 1,
  "id": "dancingsquared",
  "version": "${version}",
  "name": "DancingSquared",
  "description": "A simple addon for NoammAddons that completes the Dance Room in the Rift in Hypixel SkyBlock.",
  "authors": ["Noamm"],
  "contact": {},
  "license": "CC0-1.0",
  "icon": "assets/dancingsquared/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "com.github.noamm9.dancingsquared.DancingSquared",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "dancingsquared.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${kotlin_loader_version}",
    "fabric-api": "*",
    "noammaddons": "${noammaddons_version}",
    "minecraft": "${minecraft_version}"
  }
}
